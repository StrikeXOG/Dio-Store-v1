function log(type, msg) {
  const tags = {
    info:  neon('[INFO]    '),
    ok:    neon('[OK]      '),
    warn:  fire('[WARN]    '),
    err:   fire('[ERROR]   '),
    voice: ice('[VOICE]   '),
    chat:  cyber('[CHAT]    '),
    ready: neon('[READY]   '),
  };
  console.log(`${tags[type] || neon('[?]       ')}${msg}`);
}

function ask(rl, question) {
  return new Promise(resolve => rl.question(cyber(question), answer => resolve(answer.trim())));
}

function loadTokens() {
  const filePath = path.join(__dirname, 'input', 'tokens.txt');
  if (!fs.existsSync(filePath)) {
    fs.mkdirSync(path.join(__dirname, 'input'), { recursive: true });
    fs.writeFileSync(filePath, '# Discord tokens - one per line\n', 'utf8');
    log('warn', 'input/tokens.txt not found — created empty file');
    return [];
  }
  return fs.readFileSync(filePath, 'utf8')
    .split(/\r?\n/)
    .map(l => l.trim())
    .filter(l => l.length > 0 && !l.startsWith('#'));
}

function loadProxies() {
  const filePath = path.join(__dirname, 'input', 'proxies.txt');
  if (!fs.existsSync(filePath)) {
    fs.mkdirSync(path.join(__dirname, 'input'), { recursive: true });
    fs.writeFileSync(filePath, '# Proxy list - one per line\n# Format: protocol://ip:port or protocol://user:pass@ip:port\n', 'utf8');
    return [];
  }
  return fs.readFileSync(filePath, 'utf8')
    .split(/\r?\n/)
    .map(l => l.trim())
    .filter(l => l.length > 0 && !l.startsWith('#'));
}

function removeProxy(proxyUrl) {
  const filePath = path.join(__dirname, 'input', 'proxies.txt');
  if (!fs.existsSync(filePath)) return;
  const lines = fs.readFileSync(filePath, 'utf8')
    .split(/\r?\n/)
    .filter(l => l.trim() !== proxyUrl && l.trim() !== '# Proxy list - one per line' && l.trim() !== '# Format: protocol://ip:port or protocol://user:pass@ip:port' && !l.startsWith('# Proxy') && !l.startsWith('# Format'));
  fs.writeFileSync(filePath, lines.join('\n'), 'utf8');
  log('warn', `Removed dead proxy: ${proxyUrl}`);
}

function createProxyAgent(proxyUrl) {
  if (!proxyUrl) return undefined;
  try {
    if (proxyUrl.startsWith('socks4://') || proxyUrl.startsWith('socks5://')) {
      return new SocksProxyAgent(proxyUrl);
    }
    return new HttpsProxyAgent(proxyUrl);
  } catch (err) {
    log('err', `Failed to create proxy agent for ${proxyUrl}: ${err.message}`);
    return undefined;
  }
}

function getNextProxy(currentProxy, proxies, proxyIndex) {
  if (proxies.length === 0) return { proxy: null, index: proxyIndex };
  const nextIndex = (proxyIndex + 1) % proxies.length;
  return { proxy: proxies[nextIndex], index: nextIndex };
}

async function inputChatChannel(rl) {
  log('info', 'Enter the Channel ID where tokens will chat.\n');
  let channelId = '';
  while (!channelId) {
    channelId = await ask(rl, '  CHAT CHANNEL ID > ');
    if (!channelId) log('warn', 'Channel ID required.\n');
  }
  log('ok', `Chat channel: ${channelId}\n`);
  return channelId;
}

async function inputVoiceChannels(rl) {
  log('info', 'Enter Voice Channel IDs (comma-separated).\n');
  let channels = [];
  while (channels.length === 0) {
    const raw = await ask(rl, '  VOICE CHANNELS > ');
    channels = raw.split(',').map(id => id.trim()).filter(Boolean);
    if (channels.length === 0) log('warn', 'Enter at least one voice channel ID.\n');
  }
  log('ok', `${channels.length} voice channel(s) loaded\n`);
  return channels;
}

async function inputYesNo(rl, label) {
  log('info', `${label}? (yes/no)\n`);
  const raw = await ask(rl, `  ${label} > `);
  const yes = raw.toLowerCase().startsWith('y');
  log('ok', `${label}: ${yes ? 'yes' : 'no'}\n`);
  return yes;
}

async function inputChatDelay(rl) {
  log('info', 'Chat message delay in seconds (between each reply).\n');
  let delay = 0;
  while (delay <= 0) {
    const raw = await ask(rl, '  CHAT DELAY (sec) > ');
    delay = parseInt(raw, 10);
    if (isNaN(delay) || delay <= 0) { log('warn', 'Enter a valid number > 0.\n'); delay = 0; }
  }
  log('ok', `Chat delay: ${delay}s\n`);
  return delay;
}

function printSummary(cfg) {
  const w = 58;
  const hr = '═'.repeat(w);
  const stripAnsi = (s) => s.replace(/\x1B\[[0-9;]*m/g, '');
  const pad = (text, len) => text + ' '.repeat(Math.max(0, len - stripAnsi(text).length));

  const voiceInfo = cfg.voiceChannels.length === 1
    ? `${cfg.voiceChannels.length} channel (all bots)`
    : `${cfg.voiceChannels.length} channels (split ${Math.ceil(cfg.tokens.length / cfg.voiceChannels.length)} per)`;

  console.log(cyber(`  ╔${hr}╗`));
  console.log(cyber('  ║') + neon(pad('CONFIGURATION', w)) + cyber('║'));
  console.log(cyber(`  ╠${hr}╣`));
  console.log(cyber('  ║') + pad(`  Tokens:        ${neon(String(cfg.tokens.length).padStart(3))} account(s)`, w) + cyber('║'));
  console.log(cyber('  ║') + pad(`  Proxies:       ${cfg.useProxy ? neon(String(cfg.proxies.length).padStart(3)) + ' loaded' : fire('OFF ')}`, w) + cyber('║'));
  console.log(cyber('  ║') + pad(`  Chat Channel:  ${ice(cfg.chatChannel)}`, w) + cyber('║'));
  console.log(cyber('  ║') + pad(`  Voice:         ${ice(voiceInfo)}`, w) + cyber('║'));
  console.log(cyber('  ║') + pad(`  Deafen:        ${cfg.deafen ? neon('YES') : fire('NO ')}`, w) + cyber('║'));
  console.log(cyber('  ║') + pad(`  Mute:          ${cfg.mute ? neon('YES') : fire('NO ')}`, w) + cyber('║'));
  console.log(cyber('  ║') + pad(`  Chat Delay:    ${neon(String(cfg.chatDelay).padStart(3))} sec(s)`, w) + cyber('║'));
  console.log(cyber('  ║') + pad(`  Reply Chain:   ${cfg.tokens.length < 2 ? fire('OFF (need 2+)') : neon('ACTIVE')}`, w) + cyber('║'));
  console.log(cyber(`  ╚${hr}╝`));
  console.log('');
}

function humanDelay() {
  return 1000 + Math.floor(Math.random() * 4000);
}

